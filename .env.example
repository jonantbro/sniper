# Bot token — sends status messages to your Discord channel
DISCORD_BOT_TOKEN=your_bot_token_here

# User account token — required for vanity URL API (Manage Server permission)
DISCORD_USER_TOKEN=your_user_token_here

# Discord account password — used when Discord asks for MFA on vanity change
DISCORD_PASSWORD=your_password_here

# If you have 2FA/authenticator ON, also add your TOTP secret (from authenticator setup)
# DISCORD_TOTP_SECRET=your_totp_secret_here

# Server ID where you want the vanity URL
GUILD_ID=your_guild_id_here

# Vanity code to snipe (default: gvrn)
VANITY_CODE=gvrn

# Channel for success/failure notifications (default set below)
NOTIFY_CHANNEL_ID=1526835509253636210

# How often to attempt (minutes)
INTERVAL_MINUTES=1
