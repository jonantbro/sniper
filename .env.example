# Bot token — sends status messages to your Discord channel
DISCORD_BOT_TOKEN=your_bot_token_here

# User account token — required for vanity URL API (Manage Server permission)
DISCORD_USER_TOKEN=your_user_token_here

# Discord account password — used when Discord asks for MFA on vanity change
DISCORD_PASSWORD=your_password_here

# If you use Google Authenticator / Authy (2FA ON), password alone won't work.
# Add the TOTP secret key from when you set up 2FA:
# DISCORD_TOTP_SECRET=ABCDEFGH12345678

# Or a one-time backup code from Discord 2FA settings:
# DISCORD_BACKUP_CODE=abcd-efgh-ijkl

# Paste MFA token from local_mfa.py (lasts ~5 min) — bypasses Render password block
# DISCORD_MFA_TOKEN=eyJ...

# Server ID where you want the vanity URL
GUILD_ID=your_guild_id_here

# Vanity code to snipe (default: gvrn)
VANITY_CODE=gvrn

# Channel for success/failure notifications (default set below)
NOTIFY_CHANNEL_ID=1526835509253636210

# User to spam ping when vanity is available or claimed
PING_USER_ID=1524709993499197443
PING_COUNT=5

# How often to attempt (minutes)
INTERVAL_MINUTES=1
